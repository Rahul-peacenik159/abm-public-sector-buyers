          "value": "abm",
          "mode": "id"
        },
        "tableId": {
          "__rl": true,
          "value": "signals",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "id": "0d7752e4-b4ae-48df-a79f-b36710b58792",
      "name": "Write to BigQuery abm.signals",
      "position": [
        960,
        100
      ],
      "notes": "Or swap for Slack: post each new opportunity to a channel."
    }
  ],
